     "content": {
      "content_type": "text",
      "parts": [
       "I'm building Acme Notes. Should the user store be Postgres or MongoDB?"
      ]
     }
    }
   },
   "c1-1": {
    "id": "c1-1",
    "parent": "c1-0",
    "children": [
     "c1-2"
    ],
    "message": {
     "id": "c1-1",
     "author": {
      "role": "assistant"
     },
     "create_time": 1772618060,
     "content": {
      "content_type": "text",
      "parts": [
       "Both work. MongoDB is flexible; Postgres gives you relational joins and strong consistency."
      ]
     }
    }
   },
   "c1-2": {
    "id": "c1-2",
    "parent": "c1-1",
    "children": [
     "c1-3"
    ],
    "message": {
     "id": "c1-2",
     "author": {
      "role": "user"
     },
     "create_time": 1772618120,
     "content": {
      "content_type": "text",
      "parts": [
       "We need joins across users, orgs and shared notebooks. Ok let's go with Postgres, not MongoDB."
      ]
     }
    }
   },
   "c1-3": {
    "id": "c1-3",
    "parent": "c1-2",
    "children": [],
    "message": {
     "id": "c1-3",
     "author": {
      "role": "assistant"
     },
     "create_time": 1772618180,
     "content": {
      "content_type": "text",
      "parts": [
       "Great choice. I'll design the schema around Postgres."
      ]
     }
    }
   }
  }
