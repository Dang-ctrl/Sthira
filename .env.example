# Copy to .env (gitignored) and fill in. Never commit real values.

# --- Local (default): Ollama, no keys needed ---
# STHIRA_PROVIDER=ollama
# STHIRA_MODEL=qwen3:4b
# OLLAMA_HOST=http://localhost:11434

# --- Hosted open-weight model (the live demo uses Groq) ---
# STHIRA_PROVIDER=openai
# STHIRA_OPENAI_BASE_URL=https://api.groq.com/openai/v1
# STHIRA_OPENAI_API_KEY=
# STHIRA_MODEL=qwen/qwen3.8-27b
# STHIRA_FALLBACK_MODEL=openai/gpt-oss-120b   # used when the first model is rate limited

# --- Paid key, local testing only. NOT part of the live deployment. Nothing in Sthira reads it yet. ---
# ANTHROPIC_API_KEY=
