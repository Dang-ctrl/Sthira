     "author": {
      "role": "assistant"
     },
     "create_time": 1779285690.0,
     "content": {
      "content_type": "text",
      "parts": [
       "You could use APNs directly for iOS, or a service like OneSignal."
      ]
     }
    }
   },
   "acme-push-2": {
    "id": "acme-push-2",
    "parent": "acme-push-1",
    "children": [
     "acme-push-3"
    ],
    "message": {
     "id": "acme-push-2",
     "author": {
      "role": "user"
     },
     "create_time": 1779285780.0,
     "content": {
      "content_type": "text",
      "parts": [
       "Lesson learned: don't rely on FCM for iOS. Let's use APNs directly for iOS push."
      ]
     }
    }
   },
   "acme-push-3": {
    "id": "acme-push-3",
    "parent": "acme-push-2",
    "children": [],
    "message": {
