 {
  "id": "acme-auth",
  "conversation_id": "acme-auth",
  "title": "Acme Notes: login flow",
  "create_time": 1773055800.0,
  "current_node": "acme-auth-3",
  "mapping": {
   "acme-auth-root": {
    "id": "acme-auth-root",
    "message": null,
    "parent": null,
    "children": [
     "acme-auth-0"
    ]
   },
   "acme-auth-0": {
    "id": "acme-auth-0",
    "parent": "acme-auth-root",
    "children": [
     "acme-auth-1"
    ],
    "message": {
     "id": "acme-auth-0",
     "author": {
      "role": "user"
     },
     "create_time": 1773055800.0,
     "content": {
      "content_type": "text",
      "parts": [
       "For Acme Notes login, should I do email+password, OAuth, or magic links?"
      ]
     }
    }
   },
   "acme-auth-1": {
    "id": "acme-auth-1",
    "parent": "acme-auth-0",
    "children": [
     "acme-auth-2"
    ],
    "message": {
     "id": "acme-auth-1",
     "author": {
      "role": "assistant"
     },
     "create_time": 1773055890.0,
     "content": {
      "content_type": "text",
      "parts": [
       "Magic links remove password resets and credential stuffing risk. OAuth is convenient but adds provider dependencies. Passwords are familiar but costly to support."
      ]
     }
    }
   },
   "acme-auth-2": {
    "id": "acme-auth-2",
    "parent": "acme-auth-1",
    "children": [
     "acme-auth-3"
    ],
    "message": {
     "id": "acme-auth-2",
     "author": {
      "role": "user"
     },
     "create_time": 1773055980.0,
     "content": {
      "content_type": "text",
      "parts": [
       "Password resets were half our support tickets at my last job. Let's do magic links only, no passwords."
      ]
     }
    }
   },
   "acme-auth-3": {
    "id": "acme-auth-3",
    "parent": "acme-auth-2",
    "children": [],
    "message": {
     "id": "acme-auth-3",
     "author": {
      "role": "assistant"
     },
     "create_time": 1773056070.0,
     "content": {
      "content_type": "text",
      "parts": [
       "Makes sense. I'll plan an email magic-link flow with 15 minute expiry."
      ]
     }
    }
   }
  }
 },
 {
  "id": "acme-crdt",
  "conversation_id": "acme-crdt",
  "title": "Explain CRDTs",
  "create_time": 1773565200.0,
  "current_node": "acme-crdt-3",
  "mapping": {
   "acme-crdt-root": {
    "id": "acme-crdt-root",
    "message": null,
    "parent": null,
    "children": [
     "acme-crdt-0"
    ]
   },
   "acme-crdt-0": {
    "id": "acme-crdt-0",
    "parent": "acme-crdt-root",
    "children": [
     "acme-crdt-1"
    ],
    "message": {
     "id": "acme-crdt-0",
     "author": {
      "role": "user"
     },
     "create_time": 1773565200.0,
     "content": {
      "content_type": "text",
      "parts": [
       "Can you explain CRDTs simply?"
      ]
     }
    }
   },
   "acme-crdt-1": {
    "id": "acme-crdt-1",
    "parent": "acme-crdt-0",
    "children": [
     "acme-crdt-2"
    ],
    "message": {
     "id": "acme-crdt-1",
     "author": {
      "role": "assistant"
     },
     "create_time": 1773565290.0,
     "content": {
      "content_type": "text",
      "parts": [
       "CRDTs are data structures that let multiple replicas edit independently and merge without conflicts, like a shared counter that only adds."
      ]
     }
    }
   },
   "acme-crdt-2": {
    "id": "acme-crdt-2",
    "parent": "acme-crdt-1",
    "children": [
     "acme-crdt-3"
    ],
    "message": {
     "id": "acme-crdt-2",
     "author": {
      "role": "user"
     },
     "create_time": 1773565380.0,
     "content": {
      "content_type": "text",
      "parts": [
       "nice, and how is that different from operational transforms?"
      ]
     }
    }
   },
   "acme-crdt-3": {
    "id": "acme-crdt-3",
    "parent": "acme-crdt-2",
    "children": [],
    "message": {
     "id": "acme-crdt-3",
     "author": {
      "role": "assistant"
     },
     "create_time": 1773565470.0,
     "content": {
      "content_type": "text",
      "parts": [
       "OT transforms concurrent operations against each other through a central server; CRDTs merge by design without coordination."
      ]
     }
    }
   }
  }
 },
